# PIC-SURE HPDS Query Service environment (BDC). Rendered by template-renderer,
# uploaded to s3://<bucket>/configs/query/<stack>/query.env, fetched by
# deploy-query.sh. DB-free; the single HPDS ingress.

# Split HPDS backends via Route53 private DNS (auth = non-obfuscated,
# open = aggregate/obfuscated).
HPDS_AUTH_URL=http://auth-hpds.${target_stack}.${env_private_dns_name}:8080/PIC-SURE
HPDS_OPEN_URL=http://open-hpds.${target_stack}.${env_private_dns_name}:8080/PIC-SURE
# Blank = no bearer sent; matches today's aggregate-resource.properties
# (target.picsure.token was empty). Spec open item 2 / FO-4.
HPDS_AUTH_TOKEN=
HPDS_OPEN_TOKEN=

OPERATIONS_SERVICE_URL=http://pic-sure-operations-service:8080
QUERY_SERVICE_INTERNAL_TOKEN=${query_service_internal_token}

# Aggregate / obfuscation (was aggregate-resource.properties in the wildfly
# container: threshold 10 / variance 3 are the application.yml defaults).
# Resource ids blank pending spec open item 7.
VISUALIZATION_URL=http://visualization
AGGREGATE_VISUALIZATION_RESOURCE_ID=
AGGREGATE_TARGET_RESOURCE_ID=
AGGREGATE_OBFUSCATION_SALT=${aggregate_obfuscation_salt}

PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_APPLICATION_TOKEN=${picsure_application_token}
