# PIC-SURE Gateway environment (BDC). Rendered by template-renderer, uploaded to
# s3://<bucket>/configs/gateway/<stack>/gateway.env, fetched by deploy-gateway.sh
# and passed to podman --env-file. Env vars here override application.yml defaults.

# The aio profile's downstream defaults match BDC's container names on the picsure
# podman network; BDC-specific targets are overridden below. A dedicated bdc
# profile in the gateway is tracked as spec open item 5.
SPRING_PROFILE=aio

# PSAMA introspection (same-host container via podman network DNS).
TOKEN_INTROSPECTION_URL=http://psama:8090/auth/token/inspect
OPEN_ACCESS_VALIDATE_URL=http://psama:8090/auth/open/validate
TOKEN_INTROSPECTION_TOKEN=${picsure_token_introspection_token}

GATEWAY_OPEN_ACCESS_ENABLED=${include_open_hpds}

# Audit logging.
LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=${logging_api_key}

# Actuator: health powers the deploy liveness probe and downstream aggregation;
# detail requires the X-Application-Token.
PICSURE_ACTUATOR_EXPOSURE=health,info
PICSURE_ACTUATOR_DETAILS=when_authorized
PICSURE_APPLICATION_TOKEN=${picsure_application_token}

# operations-service /internal/** — base URL AND shared secret (X-PIC-SURE-INTERNAL-TOKEN).
# The URL is load-bearing beyond routing: QueryAuthFetcher GETs
# {OPERATIONS_SERVICE_URL}/operations/internal/queries/{id}/dispatch to fetch the stored
# query so PSAMA can authorize the bodyless /query/{id}/result and /signed-url reads.
# picsure.gateway.security.operations-service-url defaults to EMPTY (unlike the /operations
# route uri, which defaults to this same host), so leaving this unset made every download
# fail with an opaque 500 while every other endpoint kept working.
OPERATIONS_SERVICE_URL=http://pic-sure-operations-service:8080
QUERY_SERVICE_INTERNAL_TOKEN=${query_service_internal_token}

# BDC override: the aio profile deep-health-polls HPDS_URL (default http://hpds:8080,
# which does not exist on BDC). Point it at the auth HPDS instance.
HPDS_URL=http://auth-hpds.${target_stack}.${env_private_dns_name}:8080

# ---- Rate limiting (open access) ----
# Off by default. Limits are per minute and per UTC day; every limit must be a
# positive integer. Once RATE_LIMIT_ENABLED=true on this deployment, publish
# them on the API page by setting the frontend's branding.apiPage.rateLimits
# {perMinute, perDay} to the RATE_LIMIT_USER_* numbers; leave that key unset
# while the limiter is off.
RATE_LIMIT_ENABLED=${rate_limit_enabled}
RATE_LIMIT_USER_BURST_PER_MINUTE=60
RATE_LIMIT_USER_SUSTAINED_PER_DAY=3000
RATE_LIMIT_SESSION_BURST_PER_MINUTE=60
RATE_LIMIT_SESSION_SUSTAINED_PER_DAY=3000
RATE_LIMIT_IP_BURST_PER_MINUTE=60
RATE_LIMIT_IP_SUSTAINED_PER_DAY=3000
RATE_LIMIT_IP_PREVALIDATION_PER_MINUTE=300
RATE_LIMIT_STORE_MAX_SUBJECTS=100000
# Comma-separated CIDRs of the hops in front of the gateway. Before enabling, set
# rate_limit_trusted_proxies to the httpd instance's private1 subnet CIDRs, the ALB's
# public subnet CIDRs and the gateway's podman network 10.89.0.0/24, after checking on
# a dev stack which peer address the gateway actually sees. Each access-log line
# (logger gateway.access, "... peer={}") logs the TCP peer, never a header, as the last
# element of its JSON "arguments":
#   sudo podman logs gateway 2>&1 | sed -n 's/.*"loggerName":"gateway\.access".*"arguments": *\[.*,"\([^"]*\)"\].*/\1/p' | sort | uniq -c
# The gateway refuses to start with the limiter on and this empty.
# rate_limit_enabled and rate_limit_trusted_proxies are template-renderer variables, but
# the Jenkins "Render PIC-SURE Configuration" job passes a fixed -var list without them,
# so setting them on a deployed stack needs that job changed to pass them.
RATE_LIMIT_TRUSTED_PROXIES=${rate_limit_trusted_proxies}
# Comma-separated source CIDRs of non-public integrations. Every open-access request
# from these sources skips the per-IP pre-validation throttle; only PLATFORM keys from
# them also skip the post-validation limits (user keys, sessions and other open-access
# traffic from them are still limited).
RATE_LIMIT_PLATFORM_ALLOWLISTED_SOURCE_CIDRS=
