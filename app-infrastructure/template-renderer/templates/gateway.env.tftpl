# PIC-SURE Gateway environment (BDC). Rendered by template-renderer, uploaded to
# s3://<bucket>/configs/gateway/<stack>/gateway.env, fetched by deploy-gateway.sh
# and passed to podman --env-file. Env vars here override application.yml defaults.

# The aio profile's downstream defaults match BDC's container names on the picsure
# podman network; BDC-specific targets are overridden below. A dedicated bdc
# profile in the gateway is tracked as spec open item 5.
SPRING_PROFILE=aio

# PSAMA introspection (same-host container via podman network DNS).
TOKEN_INTROSPECTION_URL=http://psama:8090/auth/token/inspect
OPEN_ACCESS_VALIDATE_URL=http://psama:8090/auth/open/validate
TOKEN_INTROSPECTION_TOKEN=${picsure_token_introspection_token}

GATEWAY_OPEN_ACCESS_ENABLED=${include_open_hpds}

# Audit logging.
LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=${logging_api_key}

# Actuator: health powers the deploy liveness probe and downstream aggregation;
# detail requires the X-Application-Token.
PICSURE_ACTUATOR_EXPOSURE=health,info
PICSURE_ACTUATOR_DETAILS=when_authorized
PICSURE_APPLICATION_TOKEN=${picsure_application_token}

# Shared secret for operations-service /internal/** (X-PIC-SURE-INTERNAL-TOKEN).
QUERY_SERVICE_INTERNAL_TOKEN=${query_service_internal_token}

# BDC override: the aio profile deep-health-polls HPDS_URL (default http://hpds:8080,
# which does not exist on BDC). Point it at the auth HPDS instance.
HPDS_URL=http://auth-hpds.${target_stack}.${env_private_dns_name}:8080
