# PIC-SURE Operations Service environment (BDC). Rendered by template-renderer,
# uploaded to s3://<bucket>/configs/operations/<stack>/operations.env, fetched by
# deploy-operations.sh. Sole owner of the picsure MySQL database; serves the
# /operations context-path, so health is /operations/actuator/health.

# Datasource: the AWS Secrets Manager JDBC driver reads the username and password
# out of the app-user secret whenever it opens a connection, so a password rotation
# needs no re-render. SPRING_DATASOURCE_USERNAME holds that secret's id, not a
# database user. No database password belongs in this file.
# autoReconnect is left off on purpose: it hides the access-denied error the driver
# watches for, so a rotated password would never be re-fetched.
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.amazonaws.secretsmanager.sql.AWSSecretsManagerMySQLDriver
SPRING_DATASOURCE_URL=jdbc-secretsmanager:mysql://${picsure_db_host}/picsure?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=${app_user_secret_name}

# Shared secret enforced fail-closed on /operations/internal/**.
QUERY_SERVICE_INTERNAL_TOKEN=${query_service_internal_token}

LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=${logging_api_key}

PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_APPLICATION_TOKEN=${picsure_application_token}
