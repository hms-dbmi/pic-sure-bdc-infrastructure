# PIC-SURE Auth Micro App (PSAMA) environment (BDC). Rendered by template-renderer,
# uploaded to s3://<bucket>/configs/psama/psama.env, fetched by deploy-psama.sh. The
# S3 key carries no stack segment: one PSAMA instance authorizes every stack.
#
# The key set is derived from pic-sure-auth-services/src/main/resources/
# application.properties plus config/psama/bdc/psama-db-config.properties. Keys those
# files read but this template does not set: DATASOURCE_PASSWORD (the Secrets Manager
# driver supplies it), the nine LOGGING_LEVEL_* knobs (all default to INFO, and
# per-class debug is an operator action) and TEMPLATE_PATH (already /config/, the
# directory deploy-psama.sh mounts).

# Listen port and context path. deploy-psama.sh publishes 8090 and the gateway
# introspects http://psama:8090/auth/token/inspect.
SERVER_PORT=8090

# Actuator: off by default in application.properties. Nothing authenticates
# /auth/actuator/health, so expose health only and keep the details hidden.
PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_ACTUATOR_DETAILS=never

# Datasource through the AWS Secrets Manager JDBC driver, configured by
# psama-db-config.properties, which bdc.Dockerfile bakes into /config and loads through
# SPRING_CONFIG_ADDITIONAL_LOCATION. DATASOURCE_URL is a bare host, wrapped there into
# jdbc-secretsmanager:mysql://<host>/auth. DATASOURCE_USERNAME is a Secrets Manager
# secret id, not a username -- the driver reads the real username and the password out
# of that secret, so no database password belongs in this file.
DATASOURCE_URL=${psama_datasource_url}
DATASOURCE_USERNAME=${psama_datasource_username}

# ---- Behaviour flags: read these off the live file, never guess -------------
#
# Four flags whose values have to come off the running psama.env. Two fail OPEN, one
# decides how consent is evaluated, and one can lock every user out. None can be
# inferred from the source defaults, and the job that guards this migration compares
# key sets rather than values, so it would not catch a wrong one.
#
# ENABLE_PUBLIC_ACCESS=true drops PSAMA's auth-path guard. With consent-based
# authorization also off, a tokenless caller read every synthetic patient in the
# database unscoped (verified 2026-09-02; memory/public-access-flag-opens-auth-backend.md).
#
# STRICT_AUTHORIZATION_APPLICATIONS lists the connections that require BOTH access
# rules and privilege rules. An empty merged rule set GRANTS on a connection absent
# from this list and DENIES on one present in it, so dropping a connection from the
# list silently converts a deny into a grant
# (memory/empty-access-rules-fail-open-or-closed.md). The application.properties
# fallback is OKTA,FENCE,OPEN,RAS.
#
# CONSENT_BASED_AUTHORIZATION_ENABLED decides whether consent is evaluated for
# authorization at all. user_consents is the sole consent source for v3 queries, so
# turning it off stops per-consent scoping and changes who can see which studies. It is
# also the other half of the ENABLE_PUBLIC_ACCESS finding above: that unscoped read
# needed both flags, which is why this one is read back rather than pinned.
#
# TOS_ENABLED does not fail open, but it cannot be pinned to the application.properties
# default of true either. If the live file says false, a pinned true turns
# terms-of-service acceptance on and blocks every login until each user accepts.
#
# All four default to the empty string and are asserted non-empty by preconditions on
# aws_s3_object.psama_env, so a forgotten value fails the render instead of letting
# this file carry a guess. The three boolean ones also carry variable validation
# restricting them to exactly true or false, because Spring reads yes, on, and 1 as
# true, and such a value would pass a non-empty check while flipping behaviour.
ENABLE_PUBLIC_ACCESS=${enable_public_access}
STRICT_AUTHORIZATION_APPLICATIONS=${strict_authorization_applications}
CONSENT_BASED_AUTHORIZATION_ENABLED=${consent_based_authorization_enabled}
TOS_ENABLED=${tos_enabled}

# ---- Application identity and session policy --------------------------------
#
# APPLICATION_CLIENT_SECRET signs the PIC-SURE JWTs. application.properties gives it no
# fallback, so PSAMA fails to start without it. It is issued once and nothing here can
# mint a replacement, which is why the render aborts on a blank value instead of
# generating one.
#
# STACK_SPECIFIC_APPLICATION_ID feeds application.default.uuid and, despite the name,
# is a single UUID shared by every stack rather than a per-stack value.
APPLICATION_CLIENT_SECRET=${application_client_secret}
APPLICATION_CLIENT_SECRET_IS_BASE_64=false
STACK_SPECIFIC_APPLICATION_ID=${stack_specific_application_id}
USER_ID_CLAIM=sub
TOKEN_INCLUSION_ROLES=ADMIN,SUPER_ADMIN

# Idle timeout 15 minutes, hard session cap 8 hours, long-term token 30 days.
TOKEN_EXPIRATION_TIME=900000
MAX_SESSION_TIME=28800000
LONG_TERM_TOKEN_EXPIRATION_TIME=2592000000

# The cache inspection controller exposes cache contents and must never be on outside
# development; pinned here so the deployed state is auditable rather than implied.
CACHE_INSPECT_ENABLED=false

# ---- Naming and notification mail -------------------------------------------
#
# EMAIL_PASSWORD is issued by the mail provider and cannot be minted here, so the
# render aborts on a blank value. The remaining mail keys are cosmetic: a blank value
# renders an empty setting, which is better than the placeholder strings
# application.properties falls back to (your_email@gmail.com, email_subject,
# reply_to_email). ADMIN_USERS is the recipient list for denied-access notifications
# only -- BasicMailService is its sole consumer and it grants nobody anything.
SYSTEM_NAME=PIC-SURE BioDataCatalyst
ADMIN_USERS=${admin_users}
EMAIL_ADDRESS=${email_address}
EMAIL_PASSWORD=${email_password}
GRANT_EMAIL_SUBJECT=${grant_email_subject}
USER_ACTIVATION_REPLY_TO=${user_activation_reply_to}

# ---- Identity providers -----------------------------------------------------
#
# Every provider is off unless its flag says otherwise, which is the fail-closed
# direction: a missing flag removes a login route rather than opening one.
# OPEN_IDP_PROVIDER_IS_ENABLED reuses include_open_hpds so the open-access decision is
# stated once and cannot disagree with the gateway's GATEWAY_OPEN_ACCESS_ENABLED.
#
# Client ids, connection ids, and provider URIs are inert while their provider is
# disabled, so they carry no precondition. The three client secrets do have one, gated
# on their own provider flag: Okta, Gen3 Fence, and NIH RAS issue them and nothing here
# can regenerate one, but a provider that is switched off needs no secret and
# demanding one anyway would only produce placeholder secrets.
OPEN_IDP_PROVIDER_IS_ENABLED=${include_open_hpds}

A4_OKTA_IDP_PROVIDER_IS_ENABLED=${a4_okta_idp_provider_is_enabled}
A4_OKTA_CLIENT_ID=${a4_okta_client_id}
A4_OKTA_CLIENT_SECRET=${a4_okta_client_secret}
A4_OKTA_CONNECTION_ID=${a4_okta_connection_id}
A4_OKTA_IDP_PROVIDER_URI=${a4_okta_idp_provider_uri}

FENCE_IDP_PROVIDER_IS_ENABLED=${fence_idp_provider_is_enabled}
FENCE_IDP_PROVIDER_URI=${fence_idp_provider_uri}
FENCE_CLIENT_ID=${fence_client_id}
FENCE_CLIENT_SECRET=${fence_client_secret}

AUTH0_IDP_PROVIDER_IS_ENABLED=${auth0_idp_provider_is_enabled}
AUTH0_HOST=${auth0_host}
AUTH0_DENIED_EMAIL_ENABLED=${auth0_denied_email_enabled}

RAS_OKTA_IDP_PROVIDER_IS_ENABLED=${ras_okta_idp_provider_is_enabled}
RAS_OKTA_IDP_PROVIDER_URI=${ras_okta_idp_provider_uri}
RAS_OKTA_CONNECTION_ID=${ras_okta_connection_id}
RAS_OKTA_CLIENT_ID=${ras_okta_client_id}
RAS_OKTA_CLIENT_SECRET=${ras_okta_client_secret}
RAS_IDP_URI=${ras_idp_uri}
RAS_PASSPORT_ISSUER=${ras_passport_issuer}

# ---- Spring devtools --------------------------------------------------------
#
# spring-boot-devtools is an optional dependency and the Boot repackage goal drops it
# from the deployed jar, so this value is inert in the artifact BDC runs. The key is
# carried anyway, because a key the template omits and the live file has is the failure
# mode this migration guards against, but it carries no precondition: nothing reads it,
# so nobody should have to supply it. Worth knowing if devtools ever does ship: the
# application.properties fallback is the string "false", which is non-empty, and a
# non-empty secret is what enables the remote endpoint.
DEVTOOLS_SECRET=${devtools_secret}
