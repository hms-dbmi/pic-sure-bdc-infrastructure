# The gateway publishes port 8080 on the wildfly host; this container is on a different host.
PICSURE_GATEWAY_URL=http://wildfly.${target_stack}.${env_private_dns_name}:8080

# Shared with gateway.env. Sent on every /mcp call, so the gateway admits the assistant by ASSISTED_SEARCH.
AI_SERVICE_TOKEN=${ai_service_token}

# Off registers no chat endpoint, so /ai/chat answers 404 even though the container is up.
AI_ENABLED=${ai_service_enabled}
AI_MCP_MODE=gateway
AI_MODEL_PROVIDER=aws-sdk

# Credentials come from the instance role; ai-service-iam.tf grants bedrock:InvokeModel on this model.
BEDROCK_REGION=${bedrock_region}
BEDROCK_MODEL_ID=${bedrock_model_id}
BEDROCK_MAX_TOKENS=4096
BEDROCK_SOCKET_TIMEOUT=120s
