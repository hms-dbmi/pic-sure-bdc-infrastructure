# Single HPDS ingress: pic-sure-hpds-query-service is the ONLY service that talks to HPDS directly.
# Visualization posts /hpds/{auth,open}/v3/query/sync there; that service selects the auth/open backend
# from the path segment and applies the open path's obfuscation.
#
# This resolves the former "the visualization service takes ONE HPDS base URL but BDC splits auth/open
# HPDS" open item -- visualization no longer needs either HPDS URL. The container name and port below are
# podman DNS on the shared `picsure` network (see deploy-query.sh), so nothing is interpolated here.
HPDS_QUERY_SERVICE_URL=http://pic-sure-hpds-query-service:8080

# Audit logging. Both are required: the visualization service's audit client is a silent no-op when
# either is blank, which is why BDC visualization has been emitting no audit events at all.
LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=${logging_api_key}

# Expose actuator health for the gateway's downstream health aggregation.
PICSURE_ACTUATOR_EXPOSURE=health
