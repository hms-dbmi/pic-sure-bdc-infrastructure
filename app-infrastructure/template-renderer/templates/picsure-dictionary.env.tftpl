# PIC-SURE Dictionary Service environment (BDC). Rendered by template-renderer, uploaded
# to s3://<bucket>/configs/picsure-dictionary/picsure-dictionary.env, fetched by
# deploy-dictionary.sh. The S3 key carries no stack segment, so every stack pulls this file.

# bdc.Dockerfile's entrypoint passes --spring.profiles.active=$SPRING_PROFILE as a
# program argument, which outranks SPRING_PROFILES_ACTIVE. A blank value activates no
# profile, leaving application.properties' POSTGRES_* datasource in force instead of
# application-bdc.properties.
SPRING_PROFILE=bdc

# DATASOURCE_URL is a bare host. application-bdc.properties wraps it into
# jdbc-secretsmanager:postgresql://<host>/picsure. DATASOURCE_USERNAME holds a Secrets
# Manager secret id rather than a username. The driver reads the real username and
# password out of that secret, so no database password belongs in this file.
DATASOURCE_URL=${dictionary_datasource_url}
DATASOURCE_USERNAME=${dictionary_datasource_username}

# application.properties exposes no actuator endpoints. The gateway's downstream health
# aggregation needs the health endpoint. Nothing authenticates this service, so details
# stay hidden.
PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_ACTUATOR_DETAILS=never

# The gateway forwards one PRIV_MANAGED_* name per dbGaP consent in X-User-Privileges.
# For high-consent users that overruns Tomcat's default 8KB header budget, and Tomcat
# rejects the request with a container-level 400 before any filter runs.
PICSURE_MAX_REQUEST_HEADER_SIZE=64KB
