# PIC-SURE Dictionary Service environment (BDC). Rendered by template-renderer,
# uploaded to s3://<bucket>/configs/picsure-dictionary/picsure-dictionary.env, fetched
# by deploy-dictionary.sh. The S3 key carries no stack segment, so every stack's deploy
# pulls the same file; each stack still runs its own picsure-dictionary container.

# Load-bearing. bdc.Dockerfile's entrypoint passes --spring.profiles.active=$SPRING_PROFILE
# as a program argument, which outranks SPRING_PROFILES_ACTIVE. A blank value therefore
# activates no profile at all, leaving the POSTGRES_* datasource of
# application.properties in force instead of application-bdc.properties.
SPRING_PROFILE=bdc

# Datasource through the AWS Secrets Manager JDBC driver. DATASOURCE_URL is a bare
# host: application-bdc.properties wraps it into
# jdbc-secretsmanager:postgresql://<host>/picsure. DATASOURCE_USERNAME is a Secrets
# Manager secret id, not a username -- the driver reads the real username and the
# password out of that secret, so no database password belongs in this file.
DATASOURCE_URL=${dictionary_datasource_url}
DATASOURCE_USERNAME=${dictionary_datasource_username}

# Actuator: off by default in application.properties. Expose a shallow health endpoint
# for the gateway's downstream health aggregation; details stay hidden because nothing
# authenticates this service.
PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_ACTUATOR_DETAILS=never

# The gateway forwards one PRIV_MANAGED_* name per dbGaP consent in X-User-Privileges,
# which for high-consent users overruns Tomcat's default 8KB header budget and is
# rejected with a container-level 400 before any filter runs.
PICSURE_MAX_REQUEST_HEADER_SIZE=64KB
