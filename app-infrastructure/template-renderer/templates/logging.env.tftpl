# PIC-SURE Audit Logging Service environment (BDC). Rendered by template-renderer,
# uploaded to s3://<bucket>/configs/pic-sure-logging/logging.env, fetched by
# deploy-logging.sh. The key carries no stack segment, so every stack pulls this file.

# The gateway and visualization services must present this same key on POST /audit.
LOGGING_API_KEY=${logging_api_key}

# Every audit record carries these three. AppConfig substitutes "unknown" for any that
# is blank, so a missing value fails silently.
APP=pic-sure
PLATFORM=biodatacatalyst
ENVIRONMENT=${environment_name}

# The container publishes no ports. The gateway and visualization services reach it as
# http://pic-sure-logging on the shared podman network, and the Dockerfile's EXPOSE and
# HEALTHCHECK target 80. This port cannot change.
PORT=80

# AppConfig substitutes "*" for a blank value, so this key cannot express a narrower
# policy. Only server-side callers on the podman network POST /audit.
ALLOWED_ORIGIN=*

# JWT_CLAIM_MAPPING stays unset. Setting it replaces AppConfig's built-in claim map
# rather than merging into it, which drops the NIH and RAS claims BDC needs.
