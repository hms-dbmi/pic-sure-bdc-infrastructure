{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pic-sure.org/contracts/banner-deployment-local-result-v1.schema.json",
  "title": "PIC-SURE banner deployment-local integration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deployment",
    "status",
    "sourceCommits",
    "images",
    "rolloutContractSha256",
    "checks",
    "observations",
    "limitations",
    "deploymentExtensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deployment": {
      "enum": [
        "AIO",
        "BDC",
        "AIM_AHEAD"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "sourceCommits": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/commit"
      },
      "required": [
        "deploymentConfig",
        "backend",
        "frontend",
        "migrationSource",
        "releaseControl"
      ],
      "properties": {
        "deploymentConfig": {
          "$ref": "#/$defs/commit"
        },
        "backend": {
          "$ref": "#/$defs/commit"
        },
        "frontend": {
          "$ref": "#/$defs/commit"
        },
        "migrationSource": {
          "$ref": "#/$defs/commit"
        },
        "releaseControl": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/digestImage"
      }
    },
    "rolloutContractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTupleAndRolloutContract",
        "migrationOwner",
        "binarySchemaOwner",
        "feedRollbackOwner",
        "authorizationCacheOwner",
        "deploymentRolloutOwner",
        "authorizationAndApplicationMigrations",
        "emptyAnonymousV2Feed",
        "emptyBrowserRegion",
        "managementAuthorization",
        "publishThroughEdge",
        "auditReceipt",
        "publishedAnonymousV2Feed",
        "publishedBrowserRender",
        "cleanup"
      ],
      "properties": {
        "releaseTupleAndRolloutContract": {
          "$ref": "#/$defs/status"
        },
        "migrationOwner": {
          "$ref": "#/$defs/status"
        },
        "binarySchemaOwner": {
          "$ref": "#/$defs/status"
        },
        "feedRollbackOwner": {
          "$ref": "#/$defs/status"
        },
        "authorizationCacheOwner": {
          "$ref": "#/$defs/status"
        },
        "deploymentRolloutOwner": {
          "$ref": "#/$defs/status"
        },
        "authorizationAndApplicationMigrations": {
          "$ref": "#/$defs/status"
        },
        "emptyAnonymousV2Feed": {
          "$ref": "#/$defs/status"
        },
        "emptyBrowserRegion": {
          "$ref": "#/$defs/status"
        },
        "managementAuthorization": {
          "$ref": "#/$defs/status"
        },
        "publishThroughEdge": {
          "$ref": "#/$defs/status"
        },
        "auditReceipt": {
          "$ref": "#/$defs/status"
        },
        "publishedAnonymousV2Feed": {
          "$ref": "#/$defs/status"
        },
        "publishedBrowserRender": {
          "$ref": "#/$defs/status"
        },
        "cleanup": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emptyFeedCount",
        "emptyBannerRegionCount",
        "managementRouteCount",
        "publishedFeedCount",
        "publishedBannerRegionCount",
        "auditAction",
        "runtimeArtifacts"
      ],
      "properties": {
        "emptyFeedCount": {
          "type": "integer",
          "minimum": 0
        },
        "emptyBannerRegionCount": {
          "type": "integer",
          "minimum": 0
        },
        "managementRouteCount": {
          "type": "integer",
          "minimum": 1
        },
        "publishedFeedCount": {
          "type": "integer",
          "minimum": 0
        },
        "publishedBannerRegionCount": {
          "type": "integer",
          "minimum": 0
        },
        "auditAction": {
          "type": "string",
          "minLength": 1
        },
        "runtimeArtifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicationArtifactDigests",
            "builtImageIds",
            "publishedBannerUuid"
          ],
          "properties": {
            "applicationArtifactDigests": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/sha256"
              }
            },
            "builtImageIds": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "publishedBannerUuid": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionTls",
        "externalRouting",
        "deploymentAutomation",
        "embeddedMigrationRuntimeParity",
        "liveAuthorization",
        "peerDeploymentLocalProofs"
      ],
      "properties": {
        "productionTls": {
          "$ref": "#/$defs/status"
        },
        "externalRouting": {
          "$ref": "#/$defs/status"
        },
        "deploymentAutomation": {
          "$ref": "#/$defs/status"
        },
        "embeddedMigrationRuntimeParity": {
          "$ref": "#/$defs/status"
        },
        "liveAuthorization": {
          "$ref": "#/$defs/status"
        },
        "peerDeploymentLocalProofs": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "deploymentExtensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AIO": {
          "type": "object"
        },
        "BDC": {
          "type": "object"
        },
        "AIM_AHEAD": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployment": {
            "const": "AIO"
          }
        }
      },
      "then": {
        "properties": {
          "deploymentExtensions": {
            "required": [
              "AIO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "const": "BDC"
          }
        }
      },
      "then": {
        "properties": {
          "deploymentExtensions": {
            "required": [
              "BDC"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "const": "AIM_AHEAD"
          }
        }
      },
      "then": {
        "properties": {
          "deploymentExtensions": {
            "required": [
              "AIM_AHEAD"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digestImage": {
      "type": "string",
      "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"
    }
  }
}
